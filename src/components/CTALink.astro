---
import { getEventRegistration } from "@/lib/services/registrationService"
import { createSupabaseServerClient } from "@/lib/supabase"

const {
  eventSlug,
  class: className = "block w-full h-full",
  registerLabel = "Regístrate ahora",
} = Astro.props

let redirectHref = `/api/auth/signin?next=/registro/${eventSlug}`
let label = registerLabel

const supabase = createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies })
const { data, error } = await supabase.auth.getUser()
if (!error && data.user) {
  redirectHref = `/registro/${eventSlug}`
  const registration = await getEventRegistration(supabase, data.user.id, eventSlug)
  if (registration) {
    label = "Ver mi registro"
    if (registration.status === "pending") {
      redirectHref += "/pendiente"
    } else if (registration.status === "confirmed") {
      redirectHref += "/confirmado"
      label = "Ver credencial"
    }
  }
}
---

<a href={redirectHref} class={className}>
  {label}
</a>
