---
import cholita from "@/assets/events/nwd-26/cholita-tech.webp"
import CTALink from "@/components/CTALink.astro"
---

<section
  id="inicio"
  class="relative z-[1] overflow-hidden px-4 sm:px-6 lg:px-14 pt-8 md:pt-12 lg:pt-16 pb-10 md:pb-16 lg:pb-20"
>
  <div
    class="relative z-2 max-w-[1180px] mx-auto grid grid-cols-1 md:grid-cols-2 items-center gap-6 md:gap-8 lg:gap-10"
  >
    <!-- Copy -->
    <div class="max-w-[640px] min-w-0 text-center md:text-left">
      <p
        class="font-google font-semibold uppercase tracking-[0.28em] sm:tracking-[0.42em] text-[#1355CC] mb-1.5"
        style="font-size: clamp(13px, 1.6vw, 17px);"
      >
        Mujeres que impulsan
      </p>
      <h1
        class="font-google font-extrabold text-[#1355CC] leading-[0.9] tracking-[-0.02em] m-0"
        style="font-size: clamp(46px, 8vw, 104px); text-wrap: balance;"
      >
        EN ELLAS
      </h1>
      <div
        class="font-script text-[#10A7BC] leading-none -mt-1.5 -mb-2"
        style="font-size: clamp(56px, 9vw, 120px);"
      >
        late
      </div>
      <div
        class="font-google font-bold tracking-[0.26em] sm:tracking-[0.34em] text-[#1355CC]"
        style="font-size: clamp(20px, 3.2vw, 40px);"
      >
        BOLIVIA
      </div>
      <div class="w-[120px] h-[7px] rounded bg-[#F6BE3A] mt-[18px] mb-[26px] mx-auto md:mx-0"></div>

      <!-- Date & place -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 sm:gap-6 lg:gap-10 mt-8 mb-[30px] text-left">
        <div class="flex items-center gap-3">
          <svg
            width="42"
            height="42"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#1355CC"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="16" rx="4"></rect>
            <path d="M3 10h18M8 3v4M16 3v4"></path>
            <rect x="7" y="13.5" width="3.4" height="3.4" rx="1" fill="#F6BE3A" stroke="none"></rect>
            <rect x="13.6" y="13.5" width="3.4" height="3.4" rx="1" fill="#10A7BC" stroke="none"></rect>
          </svg>
          <div class="leading-[1.25]">
            <div class="font-google text-[11px] tracking-[0.2em] uppercase text-[#6B86B4]">
              Sábado
            </div>
            <div class="font-google font-bold text-[15px] text-[#0B2E6B]">
              11 de Octubre
            </div>
          </div>
        </div>

        <div class="hidden sm:block w-px h-10 bg-[#D5E1F5]"></div>

        <div class="flex items-center gap-3">
          <svg
            width="42"
            height="42"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#1355CC"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 21.5c4.2-4.6 6.3-7.9 6.3-10.7A6.3 6.3 0 0 0 5.7 10.8c0 2.8 2.1 6.1 6.3 10.7Z"></path>
            <circle cx="12" cy="10.6" r="2.5" fill="#10A7BC" stroke="none"></circle>
          </svg>
          <div class="leading-[1.25]">
            <div class="font-google text-[11px] tracking-[0.2em] uppercase text-[#6B86B4]">
              Facultad de
            </div>
            <div class="font-google font-bold text-[15px] text-[#0B2E6B]">
              Ciencias y Tecnología
            </div>
            <div class="font-google text-xs text-[#6B86B4]">Sucre, Bolivia</div>
          </div>
        </div>
      </div>

      <div
        class="inline-flex items-center justify-center w-full sm:w-auto px-[34px] py-4 sm:py-[18px] rounded-full bg-[#1A73E8] hover:bg-[#0B3FA0] text-white font-google font-semibold tracking-[0.14em] uppercase transition-colors [&_a]:no-underline [&_a]:text-white"
        style="font-size: clamp(14px, 1.8vw, 17px); box-shadow: 0 14px 30px rgba(26,115,232,0.32);"
      >
        <CTALink server:defer eventSlug="nwd-26">
          <span slot="fallback">Regístrate ahora</span>
        </CTALink>
      </div>
    </div>

    <!-- Illustration -->
    <div class="relative z-2 min-w-0 flex justify-center">
      <div
        class="relative w-full max-w-[260px] sm:max-w-[340px] md:max-w-[460px] flex items-center justify-center"
        style="aspect-ratio: 0.64;"
      >
        <!-- Soft halo -->
        <div
          class="absolute rounded-full"
          style="inset: 6% 8%; background: radial-gradient(circle at 40% 35%, #DCEEFB, #EAF4FD 60%, rgba(234,244,253,0) 72%);"
          aria-hidden="true"
        >
        </div>
        <!-- Orbit ring -->
        <div
          class="absolute inset-[2%] rounded-full border-2 border-[#1355CC]/30"
          style="transform: rotate(-18deg) scaleY(0.62);"
          aria-hidden="true"
        >
        </div>
        <!-- Masked photo -->
        <div
          class="absolute inset-0 overflow-hidden"
          style="
            transform: scaleX(-1);
            -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 48%, #000 70%, transparent 96%);
            mask-image: radial-gradient(ellipse 60% 70% at 50% 48%, #000 70%, transparent 96%);
          "
        >
          <img
            src={cholita.src}
            alt="Ilustración de cholita tecnóloga"
            class="absolute inset-0 w-full h-full object-cover object-top"
          />
        </div>
        <!-- Bottom fade (mobile only) -->
        <div
          class="absolute inset-x-0 bottom-0 h-1/4 md:hidden"
          style="background: linear-gradient(180deg, rgba(250,252,255,0) 0%, #FAFCFF 100%);"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Yellowtail&display=swap");

  .font-script {
    font-family: "Yellowtail", cursive;
  }
</style>
