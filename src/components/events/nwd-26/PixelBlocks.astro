---
// La decoración izquierda usa sticky; la derecha permanece fija hasta tocar el footer.
// Ocupa una pantalla completa; el contenido que le sigue la compensa con -mt-[100vh].
---

<div class="sticky top-0 h-screen z-0 pointer-events-none" aria-hidden="true">
  <!-- Top-left -->
  <div
    class="absolute top-[90px] -left-14 w-[150px] h-[150px] hidden md:grid grid-cols-2 grid-rows-2 opacity-55"
  >
    <div class="bg-[#1355CC]"></div>
    <div></div>
    <div class="bg-[#BBD5FB]"></div>
    <div class="bg-[#10A7BC]"></div>
  </div>

  <!-- Fixed until the footer reaches the decoration -->
  <footer-aware-pixels
    class="fixed top-[clamp(260px,45vh,420px)] right-0 w-[200px] h-[200px] hidden md:grid grid-cols-3 grid-rows-3 opacity-85"
  >
    <div></div><div></div><div class="bg-[#0B3FA0]"></div>
    <div></div><div class="bg-[#10A7BC]"></div><div class="bg-[#BBD5FB]"></div>
    <div class="bg-[#10A7BC]"></div><div class="bg-[#BBD5FB]"></div><div class="bg-[#F6BE3A]"></div>
  </footer-aware-pixels>
</div>


<script>
  class FooterAwarePixels extends HTMLElement {
    private cleanup?: () => void

    connectedCallback() {
      this.cleanup?.()
      const main = this.closest("main")
      if (!main) return

      let frame = 0
      const update = () => {
        frame = 0
        const fixedTop = Number.parseFloat(getComputedStyle(this).top)
        // The end of main is the top of the footer. Keep a 32px gap.
        const offset = Math.min(0, main.getBoundingClientRect().bottom - 32 - fixedTop - this.offsetHeight)
        this.style.transform = `translateY(${offset}px)`
      }
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update)
      }
      const observer = new ResizeObserver(schedule)
      observer.observe(main)
      window.addEventListener("scroll", schedule, { passive: true })
      window.addEventListener("resize", schedule)
      update()

      this.cleanup = () => {
        cancelAnimationFrame(frame)
        observer.disconnect()
        window.removeEventListener("scroll", schedule)
        window.removeEventListener("resize", schedule)
      }
    }

    disconnectedCallback() {
      this.cleanup?.()
    }
  }

  if (!customElements.get("footer-aware-pixels")) {
    customElements.define("footer-aware-pixels", FooterAwarePixels)
  }
</script>
